(* ============================== *)
(* Axiom Language - EBNF Grammar  *)
(* ============================== *)

(* --- Program Structure --- *)
program = {statement};

(* --- Statement Types --- *)
statement = (variable_declaration | assignment | display_statement)";" | if_statement | while_statement;

(* --- Variable Declaration --- *)
variable_declaration = "let" identifier "=" expression;
assignment = identifier "=" expression;

(* --- I/O Operations --- *)
display_statement = "display" "(" expression ")";

(* --- Control Structures --- *)
if_statement = "if" condition "then" {statement} ["else" {statement}] "end";
while_statement = "while" condition "do" {statement} "end";

(* --- Conditional Expressions --- *)
condition = expression (">" | "<" | "==" | "!=" | ">=" | "<=") expression;

(* --- Arithmetic Expressions --- *)
expression  = term {( "+" | "-") term};
term  = factor {( "*" | "/") factor};
factor = atom ["^" factor];
atom   = ["-"] (number | identifier | "(" expression ")");

(* --- Basic Units --- *)
identifier = (("a".."z") | ("A".."Z")) {("a".."z") | ("A".."Z") | ("0".."9") | "_"};
number = digit{digit} ["." digit {digit}];
digit = "0".."9";
